<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXPasswordField?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import io.github.palexdev.mfxresources.fonts.MFXFontIcon?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="768.0" prefWidth="1366.0"
            minHeight="600.0" minWidth="900.0"
            stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.RegisterController">

    <children>
        <BorderPane AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <!-- PAINEL LATERAL -->
            <left>
                <StackPane prefWidth="480.0"
                           minWidth="400.0"
                           styleClass="auth-visual"
                           BorderPane.alignment="CENTER">

                    <children>
                        <Circle radius="250.0"
                                fill="transparent"
                                stroke="rgba(255,255,255,0.07)"
                                strokeWidth="1.5"
                                translateX="150.0"
                                translateY="-120.0"
                                StackPane.alignment="TOP_RIGHT"/>

                        <Circle radius="200.0"
                                fill="transparent"
                                stroke="rgba(255,255,255,0.07)"
                                strokeWidth="1.5"
                                translateX="-130.0"
                                translateY="100.0"
                                StackPane.alignment="BOTTOM_LEFT"/>

                        <VBox spacing="30.0"
                              alignment="TOP_LEFT"
                              maxWidth="480.0">

                            <padding>
                                <Insets top="38.0" right="36.0"
                                        bottom="30.0" left="40.0"/>
                            </padding>

                            <children>
                                <!-- LOGÓTIPO -->
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <StackPane prefWidth="42.0"
                                                   prefHeight="38.0"
                                                   styleClass="icon">
                                            <children>
                                                <Label text="K"
                                                       style="-fx-text-fill: #0F5257;
                                                              -fx-font-weight: bold;
                                                              -fx-font-size: 19px;"/>
                                            </children>
                                        </StackPane>

                                        <Label text="Konexion"
                                               style="-fx-text-fill: white;
                                                      -fx-font-size: 23px;
                                                      -fx-font-weight: bold;"/>
                                    </children>
                                </HBox>

                                <!-- APRESENTAÇÃO -->
                                <VBox spacing="16.0"
                                      alignment="CENTER_LEFT"
                                      VBox.vgrow="ALWAYS">

                                    <children>
                                        <Label text="POUPAR JUNTOS, CRESCER JUNTOS"
                                               style="-fx-background-color: rgba(111,221,165,0.15);
                                                      -fx-text-fill: #B9EED2;
                                                      -fx-padding: 7px 11px;
                                                      -fx-background-radius: 14px;
                                                      -fx-font-size: 10px;
                                                      -fx-font-weight: bold;"/>

                                        <Label text="A sua comunidade.&#10;Os seus objetivos.&#10;Um futuro melhor."
                                               wrapText="true"
                                               style="-fx-text-fill: white;
                                                      -fx-font-size: 32px;
                                                      -fx-font-weight: bold;
                                                      -fx-line-spacing: 3px;"/>

                                        <Label text="Organize os seus grupos de poupança, acompanhe contribuições e alcance objetivos em conjunto."
                                               wrapText="true"
                                               maxWidth="340.0"
                                               style="-fx-text-fill: rgba(255,255,255,0.75);
                                                      -fx-font-size: 13px;
                                                      -fx-line-spacing: 3px;"/>

                                        <!-- CARTÕES ILUSTRATIVOS -->
                                        <Pane prefHeight="175.0"
                                              prefWidth="350.0"
                                              maxWidth="350.0">

                                            <children>
                                                <VBox layoutX="175.0"
                                                      layoutY="48.0"
                                                      prefWidth="145.0"
                                                      prefHeight="85.0"
                                                      spacing="10.0"
                                                      styleClass="visual-card-back">
                                                    <padding>
                                                        <Insets top="12.0" right="12.0"
                                                                bottom="12.0" left="12.0"/>
                                                    </padding>
                                                    <children>
                                                        <Label text="Próximo ciclo"
                                                               style="-fx-text-fill: rgba(255,255,255,0.65);
                                                                      -fx-font-size: 10px;"/>
                                                        <Label text="25 Jun"
                                                               style="-fx-text-fill: white;
                                                                      -fx-font-size: 17px;
                                                                      -fx-font-weight: bold;"/>
                                                    </children>
                                                </VBox>

                                                <VBox layoutX="10.0"
                                                      layoutY="12.0"
                                                      prefWidth="240.0"
                                                      prefHeight="132.0"
                                                      spacing="9.0"
                                                      styleClass="visual-card-front">
                                                    <padding>
                                                        <Insets top="15.0" right="15.0"
                                                                bottom="12.0" left="15.0"/>
                                                    </padding>
                                                    <children>
                                                        <Label text="Poupança do grupo"
                                                               style="-fx-text-fill: #69787B;
                                                                      -fx-font-size: 10px;"/>

                                                        <Label text="35.000,00 MT"
                                                               style="-fx-text-fill: #182426;
                                                                      -fx-font-size: 21px;
                                                                      -fx-font-weight: bold;"/>

                                                        <StackPane prefHeight="7.0"
                                                                   maxHeight="7.0"
                                                                   style="-fx-background-color: #E4ECEC;
                                                                          -fx-background-radius: 5px;">
                                                            <children>
                                                                <Region prefWidth="145.0"
                                                                        maxWidth="145.0"
                                                                        style="-fx-background-color: #0F5257;
                                                                               -fx-background-radius: 5px;"
                                                                        StackPane.alignment="CENTER_LEFT"/>
                                                            </children>
                                                        </StackPane>

                                                        <Label text="Meta: 71% alcançada"
                                                               style="-fx-text-fill: #69787B;
                                                                      -fx-font-size: 10px;"/>
                                                    </children>
                                                </VBox>

                                                <StackPane layoutX="0.0"
                                                           layoutY="0.0"
                                                           prefWidth="42.0"
                                                           prefHeight="42.0"
                                                           styleClass="coin-badge">
                                                    <children>
                                                        <Label text="MT"
                                                               style="-fx-text-fill: #6F4E00;
                                                                      -fx-font-weight: bold;
                                                                      -fx-font-size: 11px;"/>
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </Pane>
                                    </children>
                                </VBox>

                                <Label text="Seguro · Transparente · Feito para Moçambique"
                                       wrapText="true"
                                       style="-fx-text-fill: rgba(255,255,255,0.55);
                                              -fx-font-size: 10px;"/>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </left>

            <!-- PASSO 2: CREDENCIAIS -->
            <center>
                <StackPane style="-fx-background-color: #FFFFFF;"
                           BorderPane.alignment="CENTER">

                    <children>
                        <VBox alignment="CENTER_LEFT"
                              maxWidth="470.0"
                              spacing="14.0">

                            <padding>
                                <Insets top="25.0" right="25.0"
                                        bottom="25.0" left="25.0"/>
                            </padding>

                            <children>
                                <!-- VOLTAR AO LOGIN -->
                                <Hyperlink fx:id="linkVoltarLogin"
                                           text="← Voltar ao login"
                                           style="-fx-text-fill: #69787B;
                                                  -fx-font-size: 12px;
                                                  -fx-border-color: transparent;
                                                  -fx-padding: 0 0 8px 0;"/>

                                <!-- CABEÇALHO -->
                                <Label text="Criar a sua conta"
                                       style="-fx-font-size: 28px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #182426;"/>

                                <Label text="Só faltam os seus dados de acesso."
                                       wrapText="true"
                                       style="-fx-font-size: 13px;
                                              -fx-text-fill: #69787B;"/>

                                <!-- INDICADOR DE PROGRESSO -->
                                <HBox alignment="CENTER_LEFT"
                                      spacing="9.0"
                                      style="-fx-padding: 12px 0 16px 0;">

                                    <children>
                                        <StackPane minWidth="25.0"
                                                   minHeight="25.0"
                                                   style="-fx-background-color: #0F5257;
                                                          -fx-background-radius: 50px;">
                                            <children>
                                                <MFXFontIcon description="fas-check"
                                                             size="11.0"
                                                             style="-fx-fill: white;"/>
                                            </children>
                                        </StackPane>

                                        <Label text="Dados pessoais"
                                               style="-fx-font-size: 11px;
                                                      -fx-text-fill: #69787B;"/>

                                        <Separator HBox.hgrow="ALWAYS"
                                                   opacity="0.4"/>

                                        <StackPane minWidth="25.0"
                                                   minHeight="25.0"
                                                   style="-fx-background-color: #0F5257;
                                                          -fx-background-radius: 50px;">
                                            <children>
                                                <Label text="2"
                                                       style="-fx-text-fill: white;
                                                              -fx-font-size: 11px;
                                                              -fx-font-weight: bold;"/>
                                            </children>
                                        </StackPane>

                                        <Label text="Credenciais"
                                               style="-fx-font-size: 11px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #182426;"/>
                                    </children>
                                </HBox>

                                <!-- NOME DE UTILIZADOR -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="Nome de utilizador"
                                               style="-fx-font-size: 12px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #182426;"/>

                                        <MFXTextField fx:id="txtUsername"
                                                      promptText="Ex.: joaosilva"
                                                      floatMode="DISABLED"
                                                      prefHeight="44.0"
                                                      maxWidth="Infinity"
                                                      styleClass="mfx-text-field"/>
                                    </children>
                                </VBox>

                                <!-- EMAIL -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="Email"
                                               style="-fx-font-size: 12px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #182426;"/>

                                        <MFXTextField fx:id="txtEmail"
                                                      promptText="nome@exemplo.com"
                                                      floatMode="DISABLED"
                                                      prefHeight="44.0"
                                                      maxWidth="Infinity"
                                                      styleClass="mfx-text-field"/>
                                    </children>
                                </VBox>

                                <!-- SENHA E CONFIRMAÇÃO -->
                                <HBox spacing="14.0">
                                    <children>
                                        <VBox spacing="6.0"
                                              HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Senha"
                                                       style="-fx-font-size: 12px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #182426;"/>

                                                <MFXPasswordField fx:id="txtPassword"
                                                                  promptText="Introduza a senha"
                                                                  floatMode="DISABLED"
                                                                  prefHeight="44.0"
                                                                  maxWidth="Infinity"
                                                                  styleClass="mfx-password-field"/>
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0"
                                              HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Confirmar senha"
                                                       style="-fx-font-size: 12px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #182426;"/>

                                                <MFXPasswordField fx:id="txtConfirmPassword"
                                                                  promptText="Repita a senha"
                                                                  floatMode="DISABLED"
                                                                  prefHeight="44.0"
                                                                  maxWidth="Infinity"
                                                                  styleClass="mfx-password-field"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- BOTÃO CRIAR CONTA -->
                                <MFXButton fx:id="btnCriarConta"
                                           text="Criar conta  →"
                                           maxWidth="Infinity"
                                           prefHeight="46.0"
                                           styleClass="button-primary">
                                    <VBox.margin>
                                        <Insets top="8.0"/>
                                    </VBox.margin>
                                </MFXButton>

                                <!-- VOLTAR AO PASSO ANTERIOR -->
                                <MFXButton fx:id="btnVoltarPasso"
                                           text="← Voltar ao passo anterior"
                                           maxWidth="Infinity"
                                           prefHeight="42.0"
                                           style="-fx-background-color: #EAF0F0;
                                                  -fx-text-fill: #182426;
                                                  -fx-font-weight: bold;
                                                  -fx-background-radius: 8px;">
                                    <VBox.margin>
                                        <Insets top="2.0"/>
                                    </VBox.margin>
                                </MFXButton>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
